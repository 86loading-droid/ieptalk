{"key":"초5|kor","units":[{"u":"1. 바르고 고운 말","b":"5-1","g":["바르고 고운 말을 사용하여 대화할 수 있다.","상황에 맞는 바르고 고운 말을 알 수 있다.","상대방을 기분 좋게 하는 말을 할 수 있다.","상대방을 배려하는 태도를 가지며 바르고 고운 말을 할 수 있다."],"m":["6국어01-05"],"r":["6국어01-04"],"s":[{"p":"기초","n":"1","t":"바른 태도로 대화하기","c":["바른 태도로 대화하는 방법 말하기","바른 대화 태도 확인하기"]},{"p":"기본","n":"2~3","t":"상대방을 기분 좋게 하는 말 하기","c":["기분 좋게 하는 말 알아보기","상대방을 기분 좋게 하는 말 하기"]},{"p":"기본","n":"4~5","t":"상황에 알맞게 말하기","c":["상황에 알맞게 공손하게 말하기","상황에 알맞은 바른 낱말 알아보기"]},{"p":"실천","n":"6~7","t":"바르고 고운 말 하기","c":["『고마워 미안해』를 보며 바르고 고운 말 알아보기","바르고 고운 말 역할놀이 하기"]},{"p":"실천","n":"8~9","t":"바르고 고운 말 하며 마음 전하기","c":["공 굴리며 바르고 고운 말 주고받기","친구에게 바르고 고운 말 선물하기","바르고 고운 말 선물로 시 쓰고 발표하기"]},{"p":"정리","n":"10","t":"바르고 고운 말 서약서 만들기","c":["그림에 어울리는 바르고 고운 말 하기","바르고 고운 말 사용 약속하기"]}],"src":"5학년 국어"},{"u":"2. 재미있는 한글","b":"5-1","g":["모음자와 자음자의 이름을 알고 순서에 맞게 쓸 수 있다.","모음자와 자음자의 이름을 말할 수 있다.","모음자와 자음자의 획순을 알고 쓸 수 있다.","바른 자세와 태도로 모음자와 자음자를 쓸 수 있다."],"m":["6국어02-01","6국어03-01","6국어03-03"],"r":[],"s":[{"p":"기초","n":"1~2","t":"바른 자세와 태도로 글자 쓰기","c":["글자를 쓸 때 바른 자세와 태도 알기","쓰기 도구 바르게 잡기","나의 이름표 만들기"]},{"p":"기본","n":"3~4","t":"ㅣ, ㅏ, ㅓ를 읽고 쓰기","c":["모음자 ㅣ, ㅏ, ㅓ를 바르게 읽기","모음자 ㅣ, ㅏ, ㅓ를 순서에 맞게 쓰기"]},{"p":"기본","n":"5~6","t":"ㅡ, ㅗ, ㅜ를 읽고 쓰기","c":["모음자 ㅡ, ㅗ, ㅜ를 바르게 읽기","모음자 ㅡ, ㅗ, ㅜ를 순서에 맞게 쓰기"]},{"p":"기본","n":"7~8","t":"ㄱ, ㅋ의 이름을 알고 쓰기","c":["자음자 ㄱ, ㅋ의 이름 알기","자음자 ㄱ, ㅋ을 순서에 맞게 쓰기","‘ㄱ, ㅋ 동물 이름 그림책’ 만들기"]},{"p":"기본","n":"9~10","t":"ㄴ, ㄷ, ㅌ의 이름을 알고 쓰기","c":["자음자 ㄴ, ㄷ, ㅌ의 이름 알기","자음자 ㄴ, ㄷ, ㅌ을 순서에 맞게 쓰기","나의 이름과 움직임을 흉내 내는 낱말 연결하기"]},{"p":"기본","n":"11~12","t":"ㅁ, ㅂ, ㅍ의 이름을 알고 쓰기","c":["자음자 ㅁ, ㅂ, ㅍ의 이름 알기","자음자 ㅁ, ㅂ, ㅍ을 순서에 맞게 쓰기"]},{"p":"기본","n":"13~14","t":"ㅅ, ㅈ, ㅊ의 이름을 알고 쓰기","c":["자음자 ㅅ, ㅈ, ㅊ의 이름 알기","자음자 ㅅ, ㅈ, ㅊ을 순서에 맞게 쓰기","자음자 ㅅ, ㅈ, ㅊ이 들어간 물건의 이름 읽고 쓰기"]},{"p":"기본","n":"15~16","t":"ㅇ, ㅎ, ㄹ의 이름을 알고 쓰기","c":["자음자 ㅇ, ㅎ, ㄹ의 이름 알기","자음자 ㅇ, ㅎ, ㄹ을 순서에 맞게 쓰기"]},{"p":"실천","n":"17~18","t":"모음자, 자음자와 친해지기","c":["모음자와 자음자 깃발 놀이 하기","모음자와 자음자로 옷 꾸미기"]},{"p":"정리","n":"19~20","t":"모음자와 자음자 읽고 쓰기","c":["모음자와 자음자의 이름 말하기","모음자와 자음자를 순서에 맞게 쓰기"]}],"src":"5학년 국어"},{"u":"3. 뜻을 생각하며 들어요","b":"5-1","g":["낱말과 문장을 듣고 뜻을 이해할 수 있다.","사람과 사물의 특징을 나타내는 낱말과 문장을 듣고 뜻을 이해할 수 있다.","요구나 지시하는 문장을 듣고 알맞게 행동할 수 있다.","낱말과 문장을 주의 깊게 듣고 적절하게 반응하는 태도를 가질 수 있다."],"m":["6국어01-01","6국어01-02"],"r":[],"s":[{"p":"기초","n":"1~2","t":"교실에서 사용하는 말을 듣고 이해하기","c":["교실에 있는 물건의 이름 듣고 찾기","교실에서 자주 사용하는 말 듣고 행동하기"]},{"p":"기본","n":"3~5","t":"모양을 나타내는 말을 듣고 물건 찾기","c":["여러 가지 모양을 나타내는 말 알아보기","모양을 나타내는 말로 표현하기","모양을 나타내는 말 듣고 물건 찾기","모양을 나타내는 말 듣고 전달하기"]},{"p":"기본","n":"6~8","t":"특징을 듣고 알맞은 사람 찾기","c":["모습과 행동이 같은 사람 붙이기","모습과 행동을 나타내는 말 듣고 사람 찾기","그림 속 사람의 모습과 행동 말하기","모습 카드와 행동 카드에 알맞은 사람 찾기"]},{"p":"기본","n":"9~10","t":"뜻을 아는 낱말로 문장 이해하기","c":["낱말의 뜻 알아보기","문장을 듣고 몸짓으로 나타내기","문장 뜻에 어울리는 그림 찾기","문장을 듣고 그림 속에서 알맞은 사람 찾기"]},{"p":"실천","n":"11~12","t":"인물의 표정과 동작 따라 하기","c":["『간질간질』 읽어 보기","인물의 표정과 동작 따라 하기","표정과 동작을 나타내는 말 듣고 나타내기"]},{"p":"실천","n":"13~14","t":"방송을 듣고 알맞은 대상 찾기","c":["방송 듣고 알맞은 대상 찾기","안내 방송 듣고 관람 예절 안내문 완성하기","전시 해설 듣고 알맞은 전시물 찾기"]},{"p":"실천","n":"15~16","t":"내 물건 소개하기","c":["내 가방의 특징을 친구에게 설명하기","내가 좋아하는 물건의 특징을 정리하기","내가 좋아하는 물건 소개하기"]},{"p":"실천","n":"17~18","t":"설명을 듣고 카네이션 카드 만들기","c":["설명 듣고 카네이션 카드 만들기","영상 편지 찍기"]},{"p":"정리","n":"19~20","t":"특징을 찾아 표현하기","c":["특징에 알맞은 물건 찾아보기","그림 속 사람의 특징 표현하기"]}],"src":"5학년 국어"},{"u":"4. 그림 보고 내용을 알아요","b":"5-1","g":["여러 가지 매체 자료에서 그림 단서를 활용하여 문장의 내용을 이해할 수 있다.","매체 자료에서 그림을 보고 낱말의 의미를 알 수 있다.","매체 자료에서 그림이 나타내는 문장을 찾을 수 있다.","매체 자료에서 그림을 보고 내용을 파악할 수 있다.","매체 자료에서 그림을 자세히 살피는 태도를 기를 수 있다."],"m":["6국어02-02","6국어02-03"],"r":["6국어01-02"],"s":[{"p":"기초","n":"1~2","t":"그림을 자세히 살펴보기","c":["그림 속 숨어 있는 동물 찾기","그림을 자세히 살펴보고 누구인지 알아보기"]},{"p":"기본","n":"3~4","t":"그림을 보고 낱말의 뜻 알기","c":["동물의 잠자는 모습 알아보기","문장 속 낱말의 뜻 알기"]},{"p":"기본","n":"5","t":"그림을 나타내는 문장 찾기","c":["경험한 일 이야기 나누기","그림을 나타내는 문장 알기","그림의 내용을 나타내는 문장 찾기"]},{"p":"기본","n":"6~8","t":"그림을 보고 내용 생각하기","c":["만화 보고 내용 알기","이야기의 내용 짐작하기","그림을 보며 낱말의 뜻 생각하기","그림을 보며 낱말의 뜻 알기"]},{"p":"기본","n":"9~10","t":"그림을 보고 어울리는 문장 알기","c":["이야기에 어울리는 그림과 문장 알기","‘그림-문장 짝꿍 놀이’ 하기"]},{"p":"실천","n":"11~12","t":"장면의 그림이 나타내는 것 알기","c":["『지구를 지키는 가장 완벽한 방법』 읽기","그림이 나타내는 것을 생각하며 내용 알기"]},{"p":"실천","n":"13~14","t":"행동을 살펴보며 인물이 한 일 알기","c":["동물이 한 일 알기","낱말이 의미하는 것 생각하기","동물들의 행동 살펴보기"]},{"p":"실천","n":"15~16","t":"이야기의 순서를 생각하며 읽기","c":["이야기의 순서를 생각하며 읽기","우주선에 탄 동물의 순서 알기","동물들이 우주선에 가져간 물건 알기","인물에게 일어난 일 알기","이야기의 순서대로 말하기"]},{"p":"실천","n":"17~18","t":"인물의 표정을 보고 기분 알기","c":["인물의 표정을 살펴보며 그림책 읽기","표정을 살펴보며 인물의 기분 알기","동물들의 모습 살펴보기"]},{"p":"정리","n":"19~20","t":"그림책 읽고 역할놀이 하기","c":["역할놀이 방법 알기","역할놀이 준비하기","역할놀이 하기"]}],"src":"5학년 국어"},{"u":"5. 질문해 보아요","b":"5-1","g":["궁금한 것을 질문하고, 질문에 알맞게 대답할 수 있다.","‘무엇’, ‘누구’, ‘어디’의 의미를 이해할 수 있다.","‘무엇’, ‘누구’, ‘어디’를 사용하여 질문할 수 있다.","질문을 듣고 ‘무엇’, ‘누구’, ‘어디’를 구별하여 알맞게 대답할 수 있다.","질문하고 대답하여 상대방과 적극적으로 의사소통할 수 있다."],"m":["6국어01-04"],"r":["6국어01-03","6국어02-04"],"s":[{"p":"기초","n":"1~2","t":"여러 가지 방법으로 대답하기","c":["‘예’, ‘아니요’로 대답하기","질문 듣고 그림 골라 대답하기","여러 가지 방법으로 대답하기"]},{"p":"기본","n":"3","t":"높낮이를 생각하며 묻는 말 하기","c":["「비」 듣고 따라 읽기","말의 높낮이 달리하여 읽기","알맞은 높낮이로 묻는 말 하기"]},{"p":"기본","n":"4~5","t":"물건의 이름 묻기","c":["물건의 이름을 묻는 말 알아보기","역할을 나누어 질문하고 대답하기","질문하여 물건의 이름 알아보기"]},{"p":"기본","n":"6","t":"누구인지 묻기","c":["『또 누구게?』 읽고 묻는 말 알아보기","여러 가지 상황에서 모르는 사람을 묻는 말 알아보기","누구인지 질문하고 대답하며 놀이 하기"]},{"p":"기본","n":"7","t":"하는 일 묻기","c":["하는 일을 묻는 말 알아보기","친구가 하는 일 물어보기"]},{"p":"기본","n":"8~9","t":"사람이나 물건의 위치 묻기","c":["위치를 묻는 말 알아보기","그림을 보며 질문하고 대답하기","위치를 묻고 대답하며 그림 완성하기"]},{"p":"기본","n":"10~11","t":"그림 상징으로 묻는 말 만들기","c":["낱말에 어울리는 그림 상징 알아보기","그림 상징 보며 질문하고 대답하기","묻는 말을 그림 상징으로 나타내기","그림 상징 보며 여러 가지 질문하고 대답하기"]},{"p":"실천","n":"12","t":"묻고 답하며 그림책 표지 살펴보기","c":["표지 보고 제목 알아보기","질문하고 대답하며 표지의 그림 자세히 살펴보기"]},{"p":"실천","n":"13~14","t":"『개울개울 징검다리』 읽기","c":["역할 나누어 읽기","같은 소리로 끝나는 낱말을 생각하며 글 읽기","흉내 내는 말을 여러 가지 느낌으로 읽기","친구와 함께 주고받으며 읽기"]},{"p":"실천","n":"15","t":"그림책 읽으며 묻고 답하기","c":["이야기 속 질문 읽고 대답하기","등장인물에게 궁금한 것 질문하기"]},{"p":"실천","n":"16~19","t":"그림책의 장면 표현하기","c":["인물의 말과