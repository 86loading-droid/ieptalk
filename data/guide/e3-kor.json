":["「산타에게 편지가 왔어요」 읽기","산타 할아버지에게 받고 싶은 선물 생각하기","장난감 이름을 넣어 편지 완성하기"]},{"p":"3. 쓰는 즐거움 알기","n":"14","t":"보고 싶은 영상 검색하기","c":["영상 보고 자신의 생각 표현하기","「꼬마 버스 타요」 영상 검색하기","보고 싶은 영상 검색하기"]},{"p":"3. 쓰는 즐거움 알기","n":"15~16","t":"요리책 만들기","c":["「바나나 바나나」 읽고 만들고 싶은 요리 찾기","바나나 푸딩 만드는 방법 알기","바나나 요리책 만들기"]},{"p":"단원 정리","n":"17","t":"학습 내용 정리하기","c":["생각이 커져요","단원 학습 내용 되돌아보기"]}],"src":"3학년 국어"},{"u":"10. 그림으로 읽어요","b":"국어 ③","g":["그림 단서를 활용해 장면을 이해할 수 있다.","그림의 단서를 활용해 등장인물의 모습, 장소, 장면을 파악할 수 있다.","소리나 모습을 떠올리며 흉내 내는 말을 따라 읽을 수 있다.","읽고 싶은 그림책과 날씨, 미세 먼지 정보를 찾아 읽을 수 있다."],"m":["4국어02-03","4국어01-01"],"r":[],"s":[{"p":"단원 열기","n":"1","t":"단원 학습 내용 살펴보기","c":["학습 목표와 제재 확인하기","주요 낱말 익히기","사회적 상황이야기 읽고 내용 알기"]},{"p":"1. 그림 보고 내용 알기","n":"2~3","t":"등장인물의 모습과 닮은 것 찾기","c":["「똑같네 똑같아」 읽고 내용 알기","동물의 모습과 닮은 것 찾기","모습을 살펴보고 닮은 점 알기","고슴도치 만들기"]},{"p":"1. 그림 보고 내용 알기","n":"4","t":"장면 보고 장소 떠올리기","c":["장면 꾸미기","그림에 알맞은 장소 찾기","자라가 다녀온 장소 따라 쓰기"]},{"p":"1. 그림 보고 내용 알기","n":"5~6","t":"인물의 행동 보며 경험한 일 알기","c":["그림 속 단서로 기념일 알기","그림 보고 인물의 행동 말하기","그림 보고 인물이 경험한 일 말하기"]},{"p":"2. 흉내 내는 말 따라 읽기","n":"7","t":"소리나 모습을 흉내 내는 말 알기","c":["「우리 발자국 」 읽고 내용 알기","모양과 소리를 흉내 내는 말 알기","흉내 내는 말 넣어 그림 표현하기"]},{"p":"2. 흉내 내는 말 따라 읽기","n":"8","t":"흉내 내는 말을 실감 나게 읽기","c":["그림에서 단서 찾고 장소 알기","그림 붙여 도서관 안내문 완성하기","흉내 내는 말 찾아 실감 나게 따라 읽기"]},{"p":"2. 흉내 내는 말 따라 읽기","n":"9~10","t":"말의 재미를 느끼며 읽기","c":["「호호, 김치는 맛있어」 읽고 내용 알기","흉내 내는 말 넣어 재미있게 읽기","흉내 내는 말 하며 김치 만들기"]},{"p":"놀이로 배워요","n":"11","t":"‘흉내 내는 말놀이’ 하기","c":["친구와 함께 「나는 콩」 읽기","흉내 내는 말에 어울리는 손동작 하기","낱말을 바꾸어 말놀이하기"]},{"p":"3. 찾아 가며 읽기","n":"12~13","t":"그림책 표지 보고 읽고 싶은 책 고르기","c":["그림책 표지 완성하기","그림 보고 알맞은 책 제목 찾기","읽고 싶은 책 골라 발표하기"]},{"p":"3. 찾아 가며 읽기","n":"14","t":"미세 먼지 정보 읽고 알맞게 행동하기","c":["그림 보고 날씨 알기","미세 먼지 알림판 살펴보기","미세 먼지 정보에 알맞은 행동 알기"]},{"p":"3. 찾아 가며 읽기","n":"15~16","t":"날씨 정보 찾아 읽기","c":["대화 듣고 내용 알기","날씨를 나타내는 기호 알기","날씨에 어울리는 기호 찾기","여러 가지 방법으로 날씨 읽기"]},{"p":"단원 정리","n":"17","t":"학습 내용 정리하기","c":["생각이 커져요","단원 학습 내용 되돌아보기"]}],"src":"3학년 국어