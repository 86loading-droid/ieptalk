":["그림에서 굽은 선 찾기","모래 그림으로 굽은 선 표현하기","다양한 방법으로 굽은 선 표현하기"]},{"p":"기본","n":"7~8","t":"글자의 기초가 되는 모양 표현하기","c":["글자의 기초가 되는 모양 찾기","글자의 기초가 되는 모양 표현하기","모양 표현하기 놀이 하기","내가 만든 모양 점 판에 표현하기"]},{"p":"실천","n":"9~10","t":"줄무늬 표현하기","c":["「멋진 하나」 감상하기","줄무늬 따라 선 긋기","다양한 재료로 줄무늬 표현하기"]},{"p":"실천","n":"11~12","t":"그림책 속 다양한 선 표현하기","c":["그림책 『직선과 곡선』 함께 읽기","그림책 속에 나오는 선 따라 긋기","마음에 드는 선을 골라 자유롭게 표현하기"]},{"p":"실천","n":"13~14","t":"음악을 들으며 선과 모양 표현하기","c":["그림책 속 선과 모양 살펴보기","악기 소리를 선과 모양으로 표현하기","음악을 들으며 선과 모양 표현하기"]},{"p":"실천","n":"15~16","t":"상상의 나라를 여러 가지 모양으로 표현하기","c":["그림책 『그림을 그려 봐』 함께 읽기","그림책 속 장면에서 모양 찾고 따라 그리기","상상의 나라를 모양으로 표현하기"]},{"p":"정리","n":"17~18","t":"공부한 내용 정리하기","c":["선과 모양 책 만들기","선과 모양으로 교실 꾸미기"]}],"src":"1-2학년 국어"},{"u":"3. 마음을 나누어요","b":"국어 ②","g":["동화 속 주인공의 생각과 느낌을 표정, 몸짓과 연결해 살펴보고 이해할 수 있다.","상황에 맞는 표정과 몸짓으로 자신의 감정을 표현하고 사람들과 마음을 나눌 수 있다.","자신이 원하는 것을 표정과 몸짓으로 표현해 바람직한 방법으로 요구할 수 있다."],"m":["2국어01-02"],"r":["2국어02-03","2국어03-01"],"s":[{"p":"기초","n":"1~2","t":"표정과 몸짓 따라 하기","c":["표정과 몸짓이 나타내는 감정 알아보기","사진 속의 표정과 몸짓을 살펴보며 감정을 알아보기","거울을 보며 사진 속의 몸짓과 표정 따라 하기","감정 바퀴 만들기"]},{"p":"기본","n":"3~4","t":"여러 가지 감정 이해하기","c":["「컬러 몬스터」를 읽고 책에 나온 감정 배우기","컬러 몬스터의 표정과 몸짓을 보고 어울리는 감정을 알아보기","컬러 몬스터가 느낀 여러 가지 감정 분류하기","감정을 나타내는 네모 칸 위에 표정과 몸짓 붙임딱지 붙이기","표정이 바뀌는 종이 인형 만들기"]},{"p":"기본","n":"5~6","t":"감정을 표정과 몸짓으로 표현하기","c":["여러 가지 감정에 관해 이야기 나누기","명화를 보고 느껴지는 감정을 밑그림에 표현하기","감정 카드를 보며 표정과 몸짓으로 표현하기","감정 맞히기 놀이 하기"]},{"p":"기본","n":"7~8","t":"마음을 나누는 표정과 몸짓 익히기","c":["「고마워 미안해 사랑해」 아동극을 함께 보고 이야기 나누기","마음을 나누는 표정과 몸짓 익히기","「친구야 나는 너를 사랑해」 동요의 가사를 표정과 몸짓으로 표현하기","상황을 보고 알맞은 표정과 몸짓으로 표현하기"]},{"p":"기본","n":"9~10","t":"표정과 몸짓으로 요구하기","c":["「주세요 주세요」 동요로 요구하는 표정과 몸짓 익히기","「주세요 주세요」 노래책 만들기","원하는 것을 요구하는 표정과 몸짓 익히기"]},{"p":"실천","n":"11~12","t":"원하는 것을 표정과 몸짓으로 요구하기","c":["바르게 요구하는 방법 알아보기","여러 가지 상황을 보고 요구하기 표정과 몸짓 알아보기","표정과 몸짓으로 요구하기 놀이 하기","말하기 판 만들기"]},{"p":"실천","n":"13~14","t":"인물의 표정과 몸짓을 이해하고 표현하기","c":["「내 몸이 신호를 보내요」 함께 읽기","주인공의 감정이 어떻게 몸으로 표현되는지 구체적으로 알아보기","상황에 따라 느껴지는 감정을 표정과 몸짓으로 연결하기","‘내 몸이 신호를 보내요’ 카드 놀이 하기"]},{"p":"실천","n":"15~16","t":"표정과 몸짓으로 마음 나누기","c":["학교에서 일어날 수 있는 다양한 상황과 마음을 표현하는 표정과 몸짓 알아보기","상황 그림과 대본을 익혀서 역할극 연습하기","상황에 어울리는 표정과 몸짓을 알아보고 역할극 하기"]},{"p":"정리","n":"17~18","t":"공부한 내용 정리하기","c":["감정 일기 쓰기","스마트 기기로 감정 일기 쓰기","그림을 보며 어떤 상황인지 이야기 나누기","상황에 어울리는 표정과 몸짓 붙임딱지 붙이기"]}],"src":"1-2학년 국어"},{"u":"4. 내 생각을 알려요","b":"국어 ②","g":["타인에게 효과적으로 의사소통을 시도하는 방법을 알 수 있다.","자기 의사를 표현하기 위해 표정, 몸짓, 말소리, 상징 및 스마트 기기 등 다양한 방법을 활용할 수 있다.","의사소통의 중요성을 인지하고, 다른 사람에게 자발적으로 의사를 표현할 수 있다."],"m":["2국어01-03"],"r":["2국어02-03","2국어03-01"],"s":[{"p":"기초","n":"1","t":"다른 사람의 몸짓과 말에 주의 기울이기","c":["몸짓에 주의를 기울여 따라 하기","말에 주의를 기울여 따라 하기","‘걸어요 멈춰요’ 놀이 하기"]},{"p":"기본","n":"2","t":"그림책을 보고 표현하기","c":["그림책 속 몸짓과 말소리 알아보기","움직임을 생각하며 발자국 표현하기","몸짓이나 말소리로 표현한 영상 찍기"]},{"p":"기본","n":"3~4","t":"몸짓과 말소리로 의사소통 시작하기","c":["몸짓으로 의사소통 시작하기","말소리로 의사소통 시작하기"]},{"p":"기본","n":"5~6","t":"다양한 방법으로 의사 표현하기","c":["의사소통 방법 알아보기","원하는 색종이 요구하기","다양한 방법으로 고마운 마음 표현하기"]},{"p":"기본","n":"7","t":"다양한 방법으로 대답하기","c":["「어떻게 말할까?」 노래 들으며 표현하기","상황에 맞게 다양한 방법으로 대답하기"]},{"p":"기본","n":"8~9","t":"다양한 방법으로 선택하기","c":["재료 선택해 샌드위치 만들기","좋아하는 음료 선택하기","내가 가고 싶은 여행지 선택하기","여행 계획 발표하기"]},{"p":"실천","n":"10","t":"교실에서 의사소통 시도하기","c":["「꼭 잡아, 꼭!」 내용 알아보기","교실에서 생기는 의사소통 알아보기","‘꼭 잡아’ 약속 만들기"]},{"p":"실천","n":"11","t":"놀이터에서 의사소통 시도하기","c":["「꼭 잡아, 꼭!」을 읽고 표현하기","놀이터에서 안전한 행동 요구하기","스마트 기기로 「놀이터에서 꼭 잡아, 꼭!」 영상 만들기"]},{"p":"실천","n":"12~13","t":"상황에 알맞게 대답하기","c":["「기울어」를 보고 표정과 몸짓 따라 하기","주인공이 좋아하는 것 대답하기","‘나의 기울어 책’ 만들기"]},{"p":"실천","n":"14~15","t":"상황을 구성하며 표현하기","c":["상황 맥락에 어울리게 표현하기","XR 책놀이를 이용해 이야기 만들기"]},{"p":"실천","n":"16~17","t":"다양한 상황에서 의사 표현하기","c":["두루마리 화장지 놀이를 하며 의사소통 시도하기","양말 놀이를 하며 의사소통 시도하기"]},{"p":"정리","n":"18","t":"공부한 내용 정리하기","c":["자신에게 맞는 방법으로 표현하기","생각 꽃다발 만들기"]}],"src":"1-2학년 국어"},{"u":"5. 모양 나라를 여행해요","b":"국어 ②","g":["글자의 기초가 되는 여러 가지 모양을 구별할 수 있다.","물건, 그림에서 글자의 기초가 되는 모양을 찾고 표현할 수 있다.","글자의 기초가 되는 모양에 관심을 가질 수 있다."],"m":["2국어02-02"],"r":["2국어01-